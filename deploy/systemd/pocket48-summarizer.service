[Unit]
Description=Pocket48 Replay Summarizer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pocket48
Group=pocket48
WorkingDirectory=/opt/pocket48-summarizer
EnvironmentFile=/etc/pocket48-summarizer/app.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/pocket48-summarizer/.venv/bin/pocket48-summarizer
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
ReadWritePaths=/var/lib/pocket48-summarizer

[Install]
WantedBy=multi-user.target
