[Unit]
Description=Pocket48 Replay Summarizer web slot %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pocket48
Group=pocket48
WorkingDirectory=/opt/pocket48-summarizer-slots/%i
EnvironmentFile=/etc/pocket48-summarizer/app.env
EnvironmentFile=/etc/pocket48-summarizer/web-%i.env
Environment=ENABLE_WORKER=false
Environment=ENABLE_CLIPPER=true
Environment=MAINTENANCE_DIR=/run/pocket48-summarizer
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/pocket48-summarizer-slots/%i/.venv/bin/pocket48-summarizer
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
UMask=0077
RuntimeDirectory=pocket48-summarizer
RuntimeDirectoryMode=0755

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
ReadWritePaths=/var/lib/pocket48-summarizer

[Install]
WantedBy=multi-user.target
