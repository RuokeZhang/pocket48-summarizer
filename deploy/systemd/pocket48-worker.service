[Unit]
Description=Pocket48 Replay Summarizer background worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pocket48
Group=pocket48
WorkingDirectory=/opt/pocket48-summarizer-worker
EnvironmentFile=/etc/pocket48-summarizer/app.env
EnvironmentFile=/opt/pocket48-summarizer-worker/deploy/room-voice-target.env
Environment=ENABLE_WORKER=true
Environment=ENABLE_CLIPPER=false
Environment=MAINTENANCE_DIR=/run/pocket48-summarizer
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/pocket48-summarizer-worker/.venv/bin/pocket48-worker
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
UMask=0077
RuntimeDirectory=pocket48-summarizer
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
ReadWritePaths=/var/lib/pocket48-summarizer

[Install]
WantedBy=multi-user.target
