APP_HOST=127.0.0.1
APP_PORT=8000
ALLOW_REMOTE_BIND=false
TRUSTED_HOSTS=p48.ruokezhang.com,127.0.0.1,localhost
ENABLE_WORKER=false
ENABLE_CLIPPER=true
DATA_DIR=/var/lib/pocket48-summarizer
DATABASE_NAME=pocket48.sqlite3
FFMPEG_PATH=/usr/bin/ffmpeg

AUTH_REQUIRED=true
SESSION_COOKIE_SECURE=true
SESSION_TTL_DAYS=30
DAILY_JOB_LIMIT=3
UNLIMITED_JOB_USERNAMES=ruoke

MAX_REPLAY_HOURS=0
MAX_AUDIO_BYTES=536870912
FAILED_AUDIO_RETENTION_HOURS=12
HLS_CONCURRENT_FRAGMENTS=8
MAX_CLIP_MINUTES=10
CLIP_CONCURRENCY=1
CLIP_RETRY_ATTEMPTS=3
CLIP_RETRY_DELAY_SECONDS=5

ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_OSS_ENDPOINT=https://oss-cn-beijing-internal.aliyuncs.com
ALIYUN_OSS_PUBLIC_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_PREFIX=pocket48-summarizer
ALIYUN_OSS_SIGNED_URL_SECONDS=14400
ALIYUN_OSS_CLIP_PREFIX=pocket48-clips
ALIYUN_OSS_CLIP_SIGNED_URL_SECONDS=3600

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
DASHSCOPE_ASR_MODEL=fun-asr
DASHSCOPE_DIARIZATION_ENABLED=false

LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen3.7-plus
LLM_TIMEOUT_SECONDS=600
LLM_MAX_INPUT_CHARS=12000
LLM_TEMPERATURE=0.1
LLM_EXTRA_HEADERS_JSON={}
TRANSLATION_MAX_INPUT_CHARS=10000
TRANSLATION_RETRY_ATTEMPTS=3
