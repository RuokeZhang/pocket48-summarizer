APP_HOST=127.0.0.1
APP_PORT=8000
ALLOW_REMOTE_BIND=false
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
ENABLE_WORKER=true
ENABLE_CLIPPER=true
DATA_DIR=./data
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
HLS_CONCURRENT_FRAGMENTS=16
MAX_REPLAY_HOURS=0
MAX_CLIP_MINUTES=10
CLIP_CONCURRENCY=2
CLIP_RETRY_ATTEMPTS=3
CLIP_RETRY_DELAY_SECONDS=5
CLIP_EDITOR_CONTEXT_MINUTES=10
CLIP_SENTENCE_SNAP_THRESHOLD_MS=1000
CLIP_SILENCE_SEARCH_MS=1500
CLIP_SILENCE_NOISE_DB=-35
CLIP_SILENCE_MIN_DURATION_MS=200
CLIP_ANALYSIS_TIMEOUT_SECONDS=45
CLIP_ANALYSIS_CONCURRENCY=2
CLIP_FONT_NAME=Noto Sans CJK SC

# AI 封面入口始终可见；只有同时配置 Ark Key 和 Seedream 模型后，
# 管理员才能发起生成。密钥只放在本地或服务器环境文件中。
ENABLE_AI_COVERS=true
AI_COVER_PROVIDER=seedream
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_SEEDREAM_MODEL=
AI_COVER_LANDSCAPE_WIDTH=2560
AI_COVER_LANDSCAPE_HEIGHT=1440
AI_COVER_FOUR_THREE_WIDTH=2048
AI_COVER_FOUR_THREE_HEIGHT=1536
AI_COVER_REQUEST_TIMEOUT_SECONDS=180
AI_COVER_DOWNLOAD_MAX_BYTES=31457280
AI_COVER_SOURCE_URL_SECONDS=900
AI_COVER_SIGNED_URL_SECONDS=3600
AI_COVER_CONCURRENCY=1
AI_COVER_FONT_NAME=Noto Sans CJK SC
AI_COVER_PROMPT_VERSION=source-preserve-templates-v4

AUTH_REQUIRED=false
SESSION_COOKIE_SECURE=false
SESSION_TTL_DAYS=30
DAILY_JOB_LIMIT=3
UNLIMITED_JOB_USERNAMES=ruoke

# 官方成员目录由单 Worker 启动时检查，并按此间隔刷新。
MEMBER_CATALOG_URL=https://h5.48.cn/resource/jsonp/allmembers_simple.php?gid=00
MEMBER_CATALOG_SYNC_INTERVAL_SECONDS=86400
MEMBER_CATALOG_TIMEOUT_SECONDS=20
MEMBER_CATALOG_RETRY_ATTEMPTS=3
MEMBER_CATALOG_MAX_RESPONSE_BYTES=2097152

# 实验性房间上麦探针。不要提交真实值；token、pa、appInfo 和设备
# User-Agent 仅放在本机环境或受限服务器环境文件中。首次只解析 serverId，
# 再次运行才查询一次状态；未知 RTMP 主机不会自动交给 FFmpeg。
# 也可以先运行 scripts/room_voice_login.py，把一次性短信登录结果安全写入
# data/private/room-voice-credentials.json；手机号和验证码不会保存。
# 登录前先运行 scripts/provision_room_voice_pa.py：它只读取固定提交、验证
# 完整 SHA-256、提取已审查的协议常量，并保存到 data/private 的 0600 文件。
POCKET48_VOICE_TOKEN=
POCKET48_VOICE_PA=
POCKET48_VOICE_APP_INFO=
POCKET48_VOICE_USER_AGENT=
POCKET48_VOICE_MEMBER_ID=
POCKET48_VOICE_CHANNEL_ID=
POCKET48_VOICE_SERVER_ID=
POCKET48_VOICE_STREAM_HOSTS=
POCKET48_VOICE_PROBE_SECONDS=60
POCKET48_VOICE_PROBE_MAX_BYTES=52428800

ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
# ECS 可用内网上传 Endpoint；这里仍需填写供 DashScope 拉取的公网 Endpoint。
ALIYUN_OSS_PUBLIC_ENDPOINT=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_PREFIX=pocket48-summarizer
ALIYUN_OSS_SIGNED_URL_SECONDS=7200
ALIYUN_OSS_CLIP_PREFIX=pocket48-clips
ALIYUN_OSS_CLIP_SIGNED_URL_SECONDS=3600

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
DASHSCOPE_ASR_MODEL=paraformer-v2
DASHSCOPE_DIARIZATION_ENABLED=false
DASHSCOPE_VOCABULARY_ENABLED=true
DASHSCOPE_VOCABULARY_PREFIX=p48vocab
DASHSCOPE_VOCABULARY_WEIGHT=4
DASHSCOPE_VOCABULARY_MAX_TERMS=500
DASHSCOPE_VOCABULARY_READY_TIMEOUT_SECONDS=60

LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_INPUT_CHARS=12000
LLM_CHUNK_MAX_DURATION_MINUTES=6
LLM_MAX_OUTPUT_TOKENS=32768
LLM_TRUNCATION_RETRY_MAX_TOKENS=65536
LLM_TEMPERATURE=0.1
LLM_RESPONSE_FORMAT=json_object
LLM_SCHEMA_RETRY_ATTEMPTS=3
LLM_EXTRA_HEADERS_JSON={}
TRANSLATION_MAX_INPUT_CHARS=10000
TRANSLATION_RETRY_ATTEMPTS=3
