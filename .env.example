APP_HOST=127.0.0.1
APP_PORT=8000
ALLOW_REMOTE_BIND=false
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
ENABLE_WORKER=true
ENABLE_CLIPPER=true
DATA_DIR=./data
FFMPEG_PATH=ffmpeg
HLS_CONCURRENT_FRAGMENTS=16
MAX_REPLAY_HOURS=0
MAX_CLIP_MINUTES=10
CLIP_CONCURRENCY=2
CLIP_RETRY_ATTEMPTS=3
CLIP_RETRY_DELAY_SECONDS=5
AUTH_REQUIRED=false
SESSION_COOKIE_SECURE=false
SESSION_TTL_DAYS=30
DAILY_JOB_LIMIT=3
UNLIMITED_JOB_USERNAMES=ruoke

# 官方成员目录由单 Worker 启动时检查，并按此间隔刷新。
MEMBER_CATALOG_URL=https://h5.48.cn/resource/jsonp/allmembers_simple.php?gid=00
MEMBER_CATALOG_SYNC_INTERVAL_SECONDS=86400
MEMBER_CATALOG_TIMEOUT_SECONDS=20
MEMBER_CATALOG_RETRY_ATTEMPTS=3
MEMBER_CATALOG_MAX_RESPONSE_BYTES=2097152

ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
# ECS 可用内网上传 Endpoint；这里仍需填写供 DashScope 拉取的公网 Endpoint。
ALIYUN_OSS_PUBLIC_ENDPOINT=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_PREFIX=pocket48-summarizer
ALIYUN_OSS_SIGNED_URL_SECONDS=7200
ALIYUN_OSS_CLIP_PREFIX=pocket48-clips
ALIYUN_OSS_CLIP_SIGNED_URL_SECONDS=3600

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
DASHSCOPE_ASR_MODEL=paraformer-v2
DASHSCOPE_DIARIZATION_ENABLED=false
DASHSCOPE_VOCABULARY_ENABLED=true
DASHSCOPE_VOCABULARY_PREFIX=p48vocab
DASHSCOPE_VOCABULARY_WEIGHT=4
DASHSCOPE_VOCABULARY_MAX_TERMS=500
DASHSCOPE_VOCABULARY_READY_TIMEOUT_SECONDS=60

LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_INPUT_CHARS=12000
LLM_MAX_OUTPUT_TOKENS=16384
LLM_TEMPERATURE=0.1
LLM_RESPONSE_FORMAT=json_object
LLM_SCHEMA_RETRY_ATTEMPTS=3
LLM_EXTRA_HEADERS_JSON={}
TRANSLATION_MAX_INPUT_CHARS=10000
TRANSLATION_RETRY_ATTEMPTS=3
